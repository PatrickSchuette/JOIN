        "jsCode": "const response = $input.first().json;\n\n// Limit-Daten holen\nconst limitData = $('Is Limit Reached?').first().json;\n\n// 🔥 NAME SICHER EXTRAHIEREN\n// IMAP liefert ein Objekt unter 'from' mit einer Value-Liste\nconst imapFrom = $('Email Trigger (IMAP)').first().json.from;\nconst senderName =\n  imapFrom?.value?.[0]?.name ||\n  imapFrom?.name ||\n  imapFrom?.text ||\n  imapFrom?.address ||\n  response.creatorName ||\n  response.userName ||\n  \"User\";\n\n// 🔥 TITEL & DETAILS SICHER EXTRAHIEREN\nconst firebase = $('Prepare Firebase Document').first().json;\nconst title = firebase.title ?? \"(no title provided)\";\nconst category = firebase.category ?? \"General\";\nconst priority = firebase.priority ?? \"Medium\";\n\n// 🔥 LIMIT-WERTE\nconst remaining = limitData.remainingRequests ?? 0;\nconst limit = limitData.dailyLimit ?? 10;\n\n// 🔥 HTML EMAIL\nconst htmlEmail = `\n<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff;\">\n  <div style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px 30px; text-align: center; border-radius: 8px 8px 0 0;\">\n    <h1 style=\"color: #ffffff; margin: 0; font-size: 28px; font-weight: 600;\">✅ Request Received!</h1>\n  </div>\n\n  <div style=\"padding: 30px;\">\n    <p style=\"font-size: 16px; color: #333333; margin-bottom: 20px;\">Hello <strong>${senderName}</strong>,</p>\n    <p style=\"font-size: 15px; color: #555555; line-height: 1.6; margin-bottom: 25px;\">\n      Thank you for your request! Your task has been successfully created and will be available in your board.\n    </p>\n\n    <div style=\"background: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 25px;\">\n      <h3 style=\"color: #333333; margin-top: 0; margin-bottom: 15px; font-size: 18px;\">📋 Ticket Details</h3>\n      <table style=\"width: 100%; border-collapse: collapse;\">\n        <tr>\n          <td style=\"padding: 8px 0; color: #666666; font-weight: 600; width: 30%;\">Title:</td>\n          <td style=\"padding: 8px 0; color: #333333;\">${title}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px 0; color: #666666; font-weight: 600; width: 30%;\">Category:</td>\n          <td style=\"padding: 8px 0; color: #333333;\">${category}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px 0; color: #666666; font-weight: 600; width: 30%;\">Priority:</td>\n          <td style=\"padding: 8px 0; color: #333333;\">${priority}</td>\n        </tr>\n      </table>\n    </div>\n\n    <div style=\"background: #f5f5f5; padding: 15px 20px; border-radius: 4px; margin-bottom: 25px; text-align: center;\">\n      <p style=\"margin: 0; color: #666666; font-size: 14px;\">\n        Today you have <strong>${remaining} of ${limit} requests</strong> remaining\n      </p>\n    </div>\n\n    <p style=\"font-size: 14px; color: #666666; line-height: 1.6; margin-bottom: 10px;\">\n      If you have any questions, feel free to contact us anytime.\n    </p>\n  </div>\n\n  <div style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 25px 30px; text-align: center; border-radius: 0 0 8px 8px;\">\n    <p style=\"color: #ffffff; margin: 0; font-size: 16px; font-weight: 500;\">Your Join Team</p>\n    <p style=\"color: rgba(255, 255, 255, 0.8); margin: 8px 0 0 0; font-size: 12px;\">\n      This email was automatically generated. Please do not reply directly.\n    </p>\n  </div>\n</div>\n`;\n\n// Übergabe im exakten Format, das Ihr \"Send an Email\"-Node erwartet\nreturn {\n  json: {\n    subject: `✅ Your Feature Request Has Been Received - ${title}`,\n    html: htmlEmail\n  }\n};\n"
