        "jsCode": "const self = this;\n\nreturn (async () => {\n  const items = $input.all();\n\n  // 🛡️ FEHLERTOLERANZ: Immer ein gültiges Item wählen\n  const parsedData =\n    items.find(item => item.json?.isValid) ||\n    items.find(item => item.json) ||\n    items[0];\n\n  if (!parsedData?.json) {\n    // Node bekommt KEINE gültigen Daten → Fallback\n    return {\n      json: {\n        limitExceeded: false,\n        currentCount: 0,\n        dailyLimit: 10,\n        remainingRequests: 10,\n        _fallbackMode: true,\n        _error: \"No valid parsed email data found (safe fallback)\"\n      }\n    };\n  }\n\n  const input = parsedData.json;\n\n  const webhookData = items.find(item => item.json?.emailUid);\n  const emailUid = webhookData?.json?.emailUid || input.emailUid || \"unknown\";\n\n  console.log(\"📊 ===== CHECK DAILY LIMIT START =====\");\n\n  const baseUrl = \"https://join-cd262-default-rtdb.europe-west1.firebasedatabase.app\";\n\n  const today = new Date().toISOString().split(\"T\")[0];\n  const docId = `global_${today}`;\n  const limitDocPath = `daily_limits/${docId}.json`;\n\n  const maxDaily = 10;\n  const maxRetries = 5;\n\n  console.log(\"📅 Date:\", today);\n  console.log(\"📂 Path:\", limitDocPath);\n\n  // 🔁 RETRY LOOP\n  for (let attempt = 0; attempt < maxRetries; attempt++) {\n    try {\n      console.log(`\\n🔄 === ATTEMPT ${attempt + 1}/${maxRetries} ===`);\n\n      const getUrl = `${baseUrl}/${limitDocPath}`;\n\n      let getResponse;\n\n      try {\n        getResponse = await self.helpers.httpRequest({\n          method: \"GET\",\n          url: getUrl,\n          headers: { \"Content-Type\": \"application/json\" },\n          json: true,\n          returnFullResponse: true\n        });\n      } catch (getError) {\n        if (getError.statusCode === 404 || getError.message?.includes(\"404\")) {\n          console.log(\"📝 Document does not exist (404)\");\n          getResponse = { statusCode: 404, body: null };\n        } else {\n          throw getError;\n        }\n      }\n\n      let currentCount = 0;\n      let docExists = false;\n\n      console.log(\"📥 GET Status:\", getResponse?.statusCode);\n\n      if (getResponse?.statusCode === 200) {\n        const body = getResponse.body;\n\n        console.log(\"📦 Body:\", body);\n\n        if (body) {\n          currentCount = parseInt(body.count ?? 0, 10);\n          docExists = true;\n        }\n      } else if (getResponse?.statusCode === 404) {\n        currentCount = 0;\n        docExists = false;\n      } else {\n        throw new Error(`Unexpected GET status: ${getResponse?.statusCode}`);\n      }\n\n      const newCount = currentCount + 1;\n      console.log(`➕ Will increment: ${currentCount} → ${newCount}`);\n\n      // 🚫 LIMIT EXCEEDED\n      if (newCount > maxDaily) {\n        console.log(`❌ LIMIT EXCEEDED: ${newCount} > ${maxDaily}`);\n        return {\n          json: {\n            ...input,\n            emailUid,\n            limitExceeded: true,\n            currentCount,\n            dailyLimit: maxDaily,\n            remainingRequests: 0\n          }\n        };\n      }\n\n      const updateBody = {\n        date: today,\n        count: newCount,\n        lastUpdated: new Date().toISOString(),\n        lastRequestTitle: String(input.title || \"untitled\").substring(0, 100),\n        lastRequestFrom: String(input.userEmail || \"unknown\")\n      };\n\n      let writeResponse;\n\n      if (!docExists) {\n        console.log(\"📝 Creating new document with PUT...\");\n\n        writeResponse = await self.helpers.httpRequest({\n          method: \"PUT\",\n          url: `${baseUrl}/daily_limits/${docId}.json`,\n          headers: { \"Content-Type\": \"application/json\" },\n          body: updateBody,\n          json: true,\n          returnFullResponse: true\n        });\n\n        console.log(\"📤 PUT Status:\", writeResponse?.statusCode);\n\n        return {\n          json: {\n            ...input,\n            emailUid,\n            limitExceeded: false,\n            currentCount: newCount,\n            dailyLimit: maxDaily,\n            remainingRequests: maxDaily - newCount,\n            _operation: \"CREATE\"\n          }\n        };\n      } else {\n        console.log(\"🔄 Updating existing document with PATCH...\");\n\n        writeResponse = await self.helpers.httpRequest({\n          method: \"PATCH\",\n          url: `${baseUrl}/daily_limits/${docId}.json`,\n          headers: { \"Content-Type\": \"application/json\" },\n          body: updateBody,\n          json: true,\n          returnFullResponse: true\n        });\n\n        console.log(\"📤 PATCH Status:\", writeResponse?.statusCode);\n\n        return {\n          json: {\n            ...input,\n            emailUid,\n            limitExceeded: false,\n            currentCount: newCount,\n            dailyLimit: maxDaily,\n            remainingRequests: maxDaily - newCount,\n            _operation: \"UPDATE\"\n          }\n        };\n      }\n    } catch (error) {\n      console.error(`🔴 Error in attempt ${attempt + 1}:`, error.message);\n\n      if (attempt === maxRetries - 1) {\n        return {\n          json: {\n            ...input,\n            emailUid,\n            limitExceeded: false,\n            currentCount: 0,\n            dailyLimit: maxDaily,\n            remainingRequests: maxDaily,\n            _error: error.message,\n            _fallbackMode: true\n          }\n        };\n      }\n\n      console.log(`⏳ Retrying attempt ${attempt + 2}...`);\n    }\n  }\n\n  return {\n    json: {\n      ...input,\n      emailUid,\n      limitExceeded: false,\n      currentCount: 0,\n      dailyLimit: maxDaily,\n      remainingRequests: maxDaily,\n      _fallbackMode: true,\n      _error: \"Unexpected: Loop ended without return\"\n    }\n  };\n})();\n"
