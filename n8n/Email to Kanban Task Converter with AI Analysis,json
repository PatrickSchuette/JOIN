        "jsCode": "const req = $input.first()?.json || {};\n\n// 🛡️ FEHLERTOLERANZ: Wenn gar nichts kommt → Fallback-Dokument\nif (!req || typeof req !== \"object\") {\n  console.warn(\"⚠️ No input received. Using safe fallback.\");\n  return {\n    json: {\n      id: `task_${Date.now()}`,\n      title: \"(missing title)\",\n      description: \"(missing description)\",\n      category: \"User Story\",\n      priority: \"medium\",\n      status: \"boardTriage\",\n      createdBy: \"unknown\",\n      creatorName: \"unknown\",\n      creatorType: \"external\",\n      date: new Date().toISOString().split(\"T\")[0],\n      assignedTo: [],\n      subtasks: [],\n      pos: 0,\n      _fallbackMode: true\n    }\n  };\n}\n\nconsole.log(\"📥 RECEIVED FROM SUBTASK NODE:\");\nconsole.log(\"   Title:\", req?.title);\n\n// 🛡️ Pflichtfelder prüfen — aber NICHT crashen\nif (!req.type) {\n  console.warn(\"⚠️ Missing field: type → using fallback 'feature'\");\n  req.type = \"feature\";\n}\n\nif (!req.title) {\n  console.warn(\"⚠️ Missing field: title → using fallback\");\n  req.title = \"(no title)\";\n}\n\nif (!req.userEmail) {\n  console.warn(\"⚠️ Missing field: userEmail → using fallback\");\n  req.userEmail = \"unknown@unknown\";\n}\n\n// ✔ description optional machen\nif (!req.description || req.description.trim().length === 0) {\n  console.warn(\"⚠️ No description provided. Using fallback.\");\n  req.description = \"(no description provided)\";\n}\n\n// Kategorie bestimmen\nconst categoryMap = {\n  feature: \"User Story\",\n  bug: \"Technical Task\",\n  question: \"User Story\",\n  improvement: \"User Story\"\n};\n\nconst reqType = String(req.type || \"feature\").toLowerCase();\nconst category = categoryMap[reqType] || \"User Story\";\n\n// Priority bestimmen\nconst reqPriority = String(req.priority || \"medium\").toLowerCase();\nconst priority = [\"high\", \"medium\", \"low\"].includes(reqPriority)\n  ? reqPriority\n  : \"medium\";\n\n// Datum bestimmen\nconst finalDate = req.date || new Date().toISOString().split(\"T\")[0];\n\n// Subtasks stabilisieren\nconst subtasks = Array.isArray(req.subtasks) ? req.subtasks : [];\n\nconst firestoreSubtasks = subtasks.map(st => ({\n  id: String(st.id || `sub_${Date.now()}`),\n  task: String(st.title || st.task || \"(no subtask title)\"),\n  completed: Boolean(st.completed)\n}));\n\nconsole.log(\"✅ Firebase document prepared:\", req.title.substring(0, 80));\nconsole.log(\"🔍 Status set to:\", req.status || \"boardTriage\");\nconsole.log(\"📋 Subtasks to save:\", firestoreSubtasks.length);\n\nconst firestoreBody = {\n  id: req.id || req.emailUid || `task_${Date.now()}`,\n  title: req.title,\n  description: req.description,\n  category,\n  priority,\n  status: \"boardTriage\",\n  createdBy: $input.first().json.from.value[0].address,\n  creatorName: $input.first().json.from.value[0].name || req.userEmail.split(\"@\")[0],\n  creatorType: \"external\",\n  date: finalDate,\n  assignedTo: req.assignedTo || [],\n  subtasks: firestoreSubtasks,\n  pos: 0\n};\n\nreturn {\n  json: firestoreBody\n};\n"
