      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconsole.log('📧 Processing Email Input');\nconsole.log(JSON.stringify(input, null, 2));\n\n/**\n * IMAP EMAIL ONLY — Webhook-Code entfernt\n */\n\nlet from = input.from?.address || input.from?.text || input.from || '';\nlet subject = input.subject || '';\nlet body =\n  input.text ||\n  input.textPlain ||\n  (typeof input.body === 'string' ? input.body : '') ||\n  input.textAsHtml ||\n  input.html ||\n  '';\n\nconst bodyStr = typeof body === 'string' ? body : String(body || '');\nconst cleanBody = bodyStr.replace(/<[^>]*>/g, '');\n\nconst emailMatch = from.match(/([^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+)/);\nconst userEmail = emailMatch ? emailMatch[1] : from;\n\nconst nameMatch = from.match(/^([^<]+)</);\nconst userName = nameMatch ? nameMatch[1].trim().replace(/\\\"/g, '') : userEmail.split('@')[0];\n\nlet type = 'feature';\n\n/**\n * TYPE detection \n */\nconst loweredSubject = subject.toLowerCase();\n\nif (loweredSubject.startsWith(\"[feature]\")) type = \"feature\";\nelse if (loweredSubject.startsWith(\"[bug]\")) type = \"bug\";\nelse if (loweredSubject.startsWith(\"[question]\")) type = \"question\";\nelse if (loweredSubject.startsWith(\"[improvement]\")) type = \"improvement\";\nelse {\n  // Fallback: Body durchsuchen\n  const loweredBody = cleanBody.toLowerCase();\n  if (loweredBody.includes(\"type: feature\")) type = \"feature\";\n  else if (loweredBody.includes(\"type: bug\")) type = \"bug\";\n  else if (loweredBody.includes(\"type: question\")) type = \"question\";\n  else if (loweredBody.includes(\"type: improvement\")) type = \"improvement\";\n}\n\n/**\n * BUG detection\n */\nconst bugWords = [\n  \"bug\",\"error\",\"crash\",\"fail\",\"broken\",\"not work\",\"doesn't work\",\n  \"vulnerability\",\"security\",\"xss\",\"sql injection\",\"exploit\",\"defect\",\"issue\"\n];\n\nconst loweredSubjectBody = (subject + \" \" + cleanBody).toLowerCase();\n\nif (type === \"feature\") {\n  for (const word of bugWords) {\n    if (loweredSubjectBody.includes(word)) {\n      type = \"bug\";\n      break;\n    }\n  }\n}\n\n/**\n * TITLE extraction — ohne Regex\n */\nlet title = subject;\n\n// Entferne [Feature] etc.\nif (title.startsWith(\"[\")) {\n  const closing = title.indexOf(\"]\");\n  if (closing !== -1) {\n    title = title.substring(closing + 1).trim();\n  }\n}\n\nif (!title || title.length < 5) {\n  const lines = cleanBody.split(\"\\n\");\n  const titleLine = lines.find(l => l.toLowerCase().startsWith(\"title:\"));\n  if (titleLine) {\n    title = titleLine.split(\":\")[1].trim();\n  } else {\n    title = \"Untitled Request\";\n  }\n}\n\n/**\n * DESCRIPTION extraction — Regex bleibt, aber ist stabil\n */\nlet description;\nconst originalRequestMatch = cleanBody.match(/##\\s*📝\\s*Original-Anfrage:\\s*\\n\\s*(.+?)(?:\\n\\s*---|\\n\\s*\\*\\*Täglich|$)/is);\n\nif (originalRequestMatch) {\n  description = originalRequestMatch[1].trim();\n} else {\n  description = cleanBody\n    .replace(/\\*\\*Dieses Ticket wurde KI-generiert[\\s\\S]*?---/g, '')\n    .replace(/\\*\\*Täglich[\\s\\S]*$/g, '')\n    .replace(/💡\\s*\\*Dieser Stakeholder[\\s\\S]*$/g, '')\n    .replace(/Type:.*?\\n/gi, '')\n    .replace(/Title:.*?\\n/gi, '')\n    .replace(/Priority:.*?\\n/gi, '')\n    .replace(/---[\\s\\S]*$/g, '')\n    .trim();\n}\n\n/**\n * PRIORITY detection\n */\nconst urgentWords = [\"urgent\",\"dringend\",\"sofort\",\"kritisch\",\"critical\",\"security\",\"high\",\"asap\",\"immediately\"];\nconst lowWords = [\"low\",\"niedrig\",\"später\",\"nice to have\",\"optional\",\"someday\"];\n\nlet priority = \"medium\";\n\nfor (const w of urgentWords) {\n  if (loweredSubjectBody.includes(w)) {\n    priority = \"high\";\n    break;\n  }\n}\n\nif (priority === \"medium\") {\n  for (const w of lowWords) {\n    if (loweredSubjectBody.includes(w)) {\n      priority = \"low\";\n      break;\n    }\n  }\n}\n\nconst timestamp = input.date || new Date().toISOString();\n\nreturn {\n  json: {\n    isValid: true,\n    reason: \"\",\n    emailUid: input.uid || input.messageId || \"empty\",\n    type,\n    title: title.substring(0, 80),\n    description,\n    userEmail,\n    userName,\n    priority,\n    status: \"triage\",\n    timestamp,\n    originalFrom: from,\n    originalSubject: subject,\n    source: \"email\"\n  }\n};\n"
